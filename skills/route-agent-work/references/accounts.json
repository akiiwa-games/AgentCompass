        }
      },
      "web_research": {
        "scope": "Gather, check and organize information from the open web or other public sources on Dot's own computer, and return a written, sourced result: surveys of options or vendors, current prices, specs or versions, documentation and changelog lookups, fact-checks, news and background roundups, comparison tables.",
        "role": "worker",
        "preferred": [],
        "effort": "As supported and justified by the task"
      },
      "text_in_text_out": {
        "scope": "Self-contained work whose whole input fits in the packet and whose deliverable is text returned to the parent: drafting, rewriting, translating, summarizing, critiquing, comparing, explaining, and reviewing the logic of a document given in full (mark that `hard`).",
        "role": "worker",
        "preferred": [],
        "effort": "As supported and justified by the task"
      },
      "exploration_analysis": {
        "scope": "Explore and analyze material on this machine and return findings as text, with light or no code: map how a codebase or system works, trace where and why something happens, read logs, configs, data files or documents, run read-only commands and throwaway scripts to measure something, audit or compare options against the local evidence, and check a document against the code, configuration or data it describes.",
        "implies": {
          "local_only": true
        },
        "role": "explorer or analyst (findings to the parent)",
        "preferred": [],
        "effort": "As supported and justified by the task"
      },
      "research_packet": {
        "scope": "Run a defined quantitative experiment, evaluation benchmark, simulation, backtest or data analysis pipeline on this machine's data. Use existing tooling or bounded experiment scripts, compare named variants against a baseline, verify statistical results and report metrics, uncertainty and reproducible artifacts.",
        "implies": {
          "local_only": true
        },
        "role": "research worker (single owner of the packet)",
        "preferred": [],
        "effort": "As supported and justified by the task"
      },
