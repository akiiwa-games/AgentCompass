  "capability_policy": {
    "schema_version": 1,
    "routes": {
      "dot_execution": {
        "scope": "A bounded assignment the user's own OpenAI Dot can finish end to end and return as a completed text deliverable.",
        "role": "worker",
        "effort": "the Dot's own",
        "implies": {
          "local_only": false
        }
      },
      "web_research": {
        "scope": "Gather, check and organize information from the open web or other public sources on Dot's own computer, and return a written, sourced result: surveys of options or vendors, current prices, specs or versions, documentation and changelog lookups, fact-checks, news and background roundups, comparison tables.",
        "role": "worker",
        "effort": "As supported and justified by the task",
        "harness_order": [
          "pi",
          "codex"
        ]
      },
      "text_in_text_out": {
        "scope": "Self-contained work whose whole input fits in the packet and whose deliverable is text returned to the parent: drafting, rewriting, translating, summarizing, critiquing, comparing, explaining, and reviewing the logic of a document given in full (mark that `hard`).",
        "role": "worker",
        "effort": "As supported and justified by the task",
        "harness_order": [
          "pi",
          "codex"
        ]
      },
      "exploration_analysis": {
        "scope": "Explore and analyze material on this machine and return findings as text, with light or no code: map how a codebase or system works, trace where and why something happens, read logs, configs, data files or documents, run read-only commands and throwaway scripts to measure something, audit or compare options against the local evidence, and check a document against the code, configuration or data it describes.",
        "implies": {
          "local_only": true
        },
        "role": "explorer or analyst (findings to the parent)",
        "effort": "High by default; xhigh when the analysis is coupled or the evidence is large and conflicting.",
        "harness_order": [
          "pi",
          "codex"
        ]
      },
      "research_packet": {
        "scope": "Run a defined quantitative experiment, evaluation benchmark, simulation, backtest or data analysis pipeline on this machine's data. Use existing tooling or bounded experiment scripts, compare named variants against a baseline, verify statistical results and report metrics, uncertainty and reproducible artifacts.",
        "implies": {
          "local_only": true
        },
        "role": "research worker (single owner of the packet)",
        "effort": "High by default; xhigh when the discrimination chain is long or the readings conflict.",
        "harness_order": [
          "pi",
          "codex"
        ]
      },
      "self_contained_code": {
        "scope": "Self-contained code and validation work whose whole input fits in the packet (the spec, interfaces and any existing source it must match; keep it to about 40,000 characters) and whose deliverable is new files with their unit tests, or a report of numbers, returned as text: a module and its tests, a script, a data-processing, backtest or validation routine.",
        "role": "worker",
        "effort": "As supported and justified by the task"
      },
      "visual_analysis": {
        "scope": "Interpret screenshots, charts, diagrams, spatial layouts, image evidence or visual discrepancies; distinct from writing frontend code.",
        "role": "visual analyst",
        "effort": "Opus high or xhigh, Astra high, Argon high, Sol high, Sonnet high, Flash high",
        "implies": {
          "visual": true
        }
      },
      "direction_reasoning": {
        "scope": "Deep reasoning and discussion of solution direction, competing architectures, assumptions, causal explanations, or which problem to solve.",
        "role": "advisor or scheme designer",
        "effort": "Argon/Opus high for worker sessions; highest available Pro effort in the web UI at frontier difficulty."
