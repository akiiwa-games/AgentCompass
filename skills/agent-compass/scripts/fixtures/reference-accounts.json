  "capability_policy": {
    "routes": {
      "dot_execution": {
        "scope": "A bounded assignment Dot can finish end to end and return as a completed text deliverable.",
        "effort": "the Dot's own",
        "role": "worker"
      },
      "web_research": {
        "scope": "Gather, check and organize information from the open web or other public sources on Dot's own computer, and return a written, sourced result: surveys of options or vendors, current prices, specs or versions, documentation and changelog lookups, fact-checks, news and background roundups, comparison tables.",
        "harness_order": [
          "pi",
          "codex"
        ],
        "effort": "As supported and justified by the task",
        "role": "worker"
      },
      "text_in_text_out": {
        "scope": "Self-contained work whose whole input fits in the packet and whose deliverable is text returned to the parent: drafting, rewriting, translating, summarizing, critiquing, comparing, explaining, and reviewing the logic of a document given in full (mark that `hard`).",
        "harness_order": [
          "pi",
          "codex"
        ],
        "effort": "As supported and justified by the task",
        "role": "worker"
      },
      "exploration_analysis": {
        "scope": "Explore and analyze material on this machine and return findings as text, with light or no code: map how a codebase or system works, trace where and why something happens, read logs, configs, data files or documents, run read-only commands and throwaway scripts to measure something, audit or compare options against the local evidence, and check a document against the code, configuration or data it describes.",
        "implies": {
          "local_only": true
        },
        "harness_order": [
          "pi",
          "codex"
        ],
        "effort": "High by default; xhigh when the analysis is coupled or the evidence is large and conflicting.",
        "role": "explorer or analyst (findings to the parent)"
      },
      "research_packet": {
        "scope": "Run a defined quantitative experiment, evaluation benchmark, simulation, backtest or data analysis pipeline on this machine's data. Use existing tooling or bounded experiment scripts, compare named variants against a baseline, verify statistical results and report metrics, uncertainty and reproducible artifacts.",
        "implies": {
          "local_only": true
        },
        "harness_order": [
          "pi",
          "codex"
        ],
        "effort": "High by default; xhigh when the discrimination chain is long or the readings conflict.",
        "role": "research worker (single owner of the packet)"
      },
      "self_contained_code": {
        "scope": "Self-contained code and validation work whose whole input fits in the packet (the spec, interfaces and any existing source it must match; keep it to about 40,000 characters) and whose deliverable is new files with their unit tests, or a report of numbers, returned as text: a module and its tests, a script, a data-processing, backtest or validation routine.",
        "effort": "As supported and justified by the task",
        "role": "worker"
      },
      "visual_analysis": {
        "scope": "Interpret screenshots, charts, diagrams, spatial layouts, image evidence or visual discrepancies; distinct from writing frontend code.",
        "effort": "Opus high or xhigh, Astra high, Argon high, Sol high, Sonnet high, Flash high",
        "role": "visual analyst"
      },
      "direction_reasoning": {
        "scope": "Deep reasoning and discussion of solution direction, competing architectures, assumptions, causal explanations, or which problem to solve.",
        "effort": "Argon/Opus high for worker sessions; highest available Pro effort in the web UI at frontier difficulty.",
        "role": "advisor or scheme designer"
      },
      "complex_build_plan": {
        "scope": "Turn an agreed direction into a repository-grounded multi-system build plan: dependencies, interfaces, staged migrations, sequencing, validation and rollback.",
        "effort": "Argon/Opus high for worker sessions; highest available Pro effort in the web UI at frontier difficulty.",
        "role": "planner (worker or advisory output)"
      },
      "general_implementation": {
        "scope": "Implement an agreed plan, maintain production features, refactor bounded code or deliver ordinary repository changes.",
        "effort": "Flash/Argon high for every worker packet; level is encoded in the model ID. Use the original supported medium/high efforts on fallbacks.",
        "role": "worker"
      },
      "debug_review": {
        "scope": "Subtle bug diagnosis, regression analysis, review of code and diffs, invariants, test-driven repairs and checking existing behavior.",
        "harness_order": [
          "codex",
          "pi"
        ],
        "effort": "Supported high/xhigh on the models listed first, more for coupled difficult failures; Argon/Flash high when assigned.",
        "role": "reviewer or debugging worker, as assigned"
      },
      "frontend_implementation": {
        "scope": "Write UI components, interactions, animations and styling from the accepted design; visual evidence inspection is a separate visual_analysis task when material.",
        "effort": "Flash/Argon high for every worker packet; supported high/medium on fallbacks.",
        "role": "worker"
      },
      "bounded_bulk_work": {
        "scope": "Homogeneous small changes, independent extraction or inventory, boilerplate and fixed transformations with explicit acceptance.",
        "effort": "Flash/Argon high for every worker packet; supported medium/high on fallbacks.",
        "role": "bounded leaf worker"
      },
      "tool_execution": {
        "scope": "A bounded outcome primarily requiring file, shell, browser, API or other tool calls, with direction and authorized actions already established.",
        "effort": "Flash/Argon high for every worker packet; level is encoded in the model ID. Fallback effort follows assignment difficulty and runtime support.",
        "role": "tool-execution worker"
      },
      "computer_use": {
        "scope": "Operate a graphical computer or app through screenshots, mouse and keyboard (computer use): GUI-only applications, desktop or browser flows with no API, clicking through settings.",
        "implies": {
          "visual": true
        },
        "harness_order": [
          "codex",
          "pi"
        ],
        "effort": "High on the models listed (Astra, Sol); unlisted vision models rank by their `gui` capability. Default difficulty is `hard` (Flash closed); a profiled small GUI task (reasoning_depth 1) or an explicit `routine` opens it to Flash and Sol.",
        "role": "computer-use worker"
      },
      "other_or_mixed": {
        "scope": "Unmatched or mixed work.",
        "effort": "As supported and justified by the task",
        "role": "parent or bounded worker"
      }
    },
    "remote_reroute_guard": {
      "enabled": true,
      "bundle_id": "dot_text",
      "window_seconds": 600
    }
  },
