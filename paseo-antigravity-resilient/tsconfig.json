{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "index.server.ts",
    "scripts/**/*.d.mts",
    "server/**/*.ts",
    "server/**/*.d.ts",
    "shared/**/*.ts",
    "test/**/*.ts"
  ]
}
