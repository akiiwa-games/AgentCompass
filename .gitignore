# Common source only. Host state, handover artifacts, upstream checkouts and
# installed dependencies stay outside this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!LICENSE
!/examples/
!examples/**
!/llms.txt
!/docs/
/docs/*
!/docs/*.png
!/tray/
/tray/*
!/tray/*.py
!/tray/*.pyw
!/tray/*.mjs
!/tray/*.js
!/tray/*.ps1
!/audit/
/audit/*
!/audit/*.py
!/setup/
/setup/*
!/setup/*.py
!/setup/pi_device_login.mjs
!/setup/paseo_dispatch_bridge.mjs
!/setup/test_paseo_dispatch_bridge.mjs
!/deployment/
/deployment/*
!/deployment/host_policy_parity.py
# The router skills; each host links ~/.codex/skills/<name> here.
!/skills/
**/__pycache__/
**/.pytest_cache/
**/*.pyc

# Safety blocklist against accidental staging in whitelisted subdirectories
**/*.log
**/*.tmp
**/*.bak
**/*endpoint.txt
**/*discovered*
**/out/
**/scratch/
**/reports/


!/setup/paseo-bridge/
/setup/paseo-bridge/*
!/setup/paseo-bridge/package.json
!/setup/paseo-bridge/package-lock.json
!/setup/paseo-bridge/README.md

!/pyproject.toml
!/agentcompass/
/agentcompass/*
!/agentcompass/*.py
!/packaging/
/packaging/*
!/packaging/*.py
!/packaging/*.ps1
!/packaging/*.iss
!/packaging/*.spec
!/packaging/*.md
!/.github/
/.github/*
!/.github/RELEASE_NOTES.md
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
